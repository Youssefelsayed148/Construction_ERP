DB_NAME=construction_erp
DB_USER=construction_erp_user
DB_PASSWORD=change-this-strong-password
JWT_SECRET=change-this-to-a-long-random-value
FRONTEND_URL=https://your-real-domain.example.com
# Required by docker-compose.yml. Prefer `npm --prefix backend run staging:env`, which generates all of these with fresh secrets.
APP_ENV=staging
WEBHOOK_ENCRYPTION_KEY=change-this-to-a-different-random-value-of-at-least-32-characters
