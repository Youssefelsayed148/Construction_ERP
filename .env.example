PORT=5000
FRONTEND_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_erp
DB_USER=construction_erp_user
DB_PASSWORD=your_db_password_here
JWT_SECRET=change-this-secret-in-production
TRUST_PROXY=false
AUTH_RATE_LIMIT_PER_15_MIN=20
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
RECONCILIATION_BACKUP_CONFIRMED=false
# Phase 26 — external API (/api/v1)
V1_TOKEN_TTL_SECONDS=3600
V1_REFRESH_TTL_SECONDS=2592000
V1_RATE_LIMIT_PER_MIN=300
CORS_EXTRA_ORIGINS=
